{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "jsx": "react-jsx",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["node"],
    "baseUrl": "."
  },
  "include": [
    "src",
    "forge.config.ts",
    "vite.*.config.ts",
    "playwright.config.ts",
    "tests",
    "vitest.config.ts"
  ]
}
